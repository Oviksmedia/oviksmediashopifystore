<main id="daybreak-main" class="native-page native-collection" tabindex="-1"><p class="native-kicker">DAYBREAK / Collection 01</p><h1>{{ collection.title | escape }}</h1><p class="native-disclosure">Fictional portfolio products. Explore the options and working Shopify demo bag.</p>
  {% paginate collection.products by 24 %}<div class="native-collection-grid">{% for item_product in collection.products %}<article><a href="{{ item_product.url }}">{% if item_product.featured_image %}{{ item_product.featured_image | image_url: width: 1000 | image_tag: widths: '350, 650, 1000', sizes: '(min-width: 800px) 30vw, 90vw', loading: 'lazy' }}{% endif %}<h2>{{ item_product.title | escape }}</h2></a><p>{{ item_product.price | money_with_currency }}{% unless item_product.available %} / Sold out{% endunless %}</p><a class="native-product-link" href="{{ item_product.url }}">Choose your options ↗</a></article>{% else %}<p>The demo catalog is being prepared.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}
</main>
{% schema %}{"name":"Collection","settings":[]}{% endschema %}
