<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }} — DAYBREAK</title><meta name="description" content="{{ page_description | default: shop.description | escape }}">{{ 'daybreak.css' | asset_url | stylesheet_tag }}{{ 'shopify-native.css' | asset_url | stylesheet_tag }}<style>:root{--native-paper:#fff5db;--native-ink:#173a84;--native-accent:#173a84;--native-button-text:#fff5db;--native-title-font:'Daybreak Fredoka',Arial,sans-serif}</style>{{ content_for_header }}<script src="{{ 'store-commerce.js' | asset_url }}" defer></script></head><body class="daybreak-demo">{% render 'store-header' %}{{ content_for_layout }}{% render 'store-footer' %}</body></html>
