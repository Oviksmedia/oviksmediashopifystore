<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }} — SIDE B</title><meta name="description" content="{{ page_description | default: shop.description | escape }}">{{ 'side-b.css' | asset_url | stylesheet_tag }}{{ 'shopify-native.css' | asset_url | stylesheet_tag }}<style>:root{--native-paper:#fff34c;--native-ink:#121212;--native-accent:#121212;--native-button-text:#fff34c;--native-title-font:'SideB Ultra',Georgia,serif}</style>{{ content_for_header }}<script src="{{ 'store-commerce.js' | asset_url }}" defer></script></head><body class="sideb-store">{% render 'store-header' %}{{ content_for_layout }}{% render 'store-footer' %}</body></html>
