<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }} — RIFT</title><meta name="description" content="{{ page_description | default: shop.description | escape }}">{{ 'rift.css' | asset_url | stylesheet_tag }}{{ 'shopify-native.css' | asset_url | stylesheet_tag }}<style>:root{--native-paper:#111917;--native-ink:#f5f7ed;--native-accent:#daff00;--native-button-text:#111917;--native-title-font:Impact,'Arial Black',Arial,sans-serif}</style>{{ content_for_header }}<script src="{{ 'store-commerce.js' | asset_url }}" defer></script></head><body class="rift-demo">{% render 'store-header' %}{{ content_for_layout }}{% render 'store-footer' %}</body></html>
