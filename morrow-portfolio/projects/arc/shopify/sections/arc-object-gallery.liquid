{%- liquid
  assign arc_product = section.settings.product | default: product
  assign arc_variant = arc_product.selected_or_first_available_variant
  assign arc_image = arc_variant.featured_image | default: arc_product.featured_image
  assign arc_form_id = 'ArcProductForm-' | append: section.id
-%}
<section class="arc-liquid" id="ArcGallery-{{ section.id }}" aria-labelledby="ArcTitle-{{ section.id }}">
  <header class="arc-liquid-intro"><p>{{ section.settings.eyebrow | escape }}</p><h2 id="ArcTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div>{{ section.settings.introduction }}</div></header>
  {% if section.settings.campaign != blank %}
    <figure class="arc-liquid-campaign">{{ section.settings.campaign | image_url: width: 2000 | image_tag: widths: '600, 1000, 1500, 2000', sizes: '100vw', loading: 'lazy' }}<figcaption>{{ section.settings.caption | escape }}</figcaption></figure>
  {% endif %}
  {% if arc_product != blank %}
    <div class="arc-liquid-workbench">
      <div class="arc-liquid-media">
        {% if arc_image != blank %}
          {{ arc_image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', class: 'arc-liquid-product-image' }}
        {% else %}<p>{{ 'arc.gallery.no_image' | t }}</p>{% endif %}
      </div>
      <div class="arc-liquid-info"><h3>{{ arc_product.title | escape }}</h3><p class="arc-liquid-price">{{ arc_variant.price | money_with_currency }}</p><div>{{ arc_product.description }}</div>
        {% form 'product', arc_product, id: arc_form_id %}
          {{ form.errors | default_errors }}
          <label for="ArcVariant-{{ section.id }}">{{ 'arc.gallery.finish' | t }}</label>
          <select name="id" id="ArcVariant-{{ section.id }}" required>
            {% for variant in arc_product.variants %}
              {%- liquid
                assign arc_variant_text = variant.title
                assign arc_variant_image = variant.featured_image | default: arc_product.featured_image
                assign arc_id_text = variant.id | append: ''
                for block in section.blocks
                  if block.settings.variant_id == arc_id_text
                    if block.settings.label != blank
                      assign arc_variant_text = block.settings.label
                    endif
                    if block.settings.image != blank
                      assign arc_variant_image = block.settings.image
                    endif
                  endif
                endfor
              -%}
              <option value="{{ variant.id }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}" data-money="{{ variant.price | money_with_currency | escape }}" data-available="{{ variant.available }}" data-image="{% if arc_variant_image != blank %}{{ arc_variant_image | image_url: width: 1200 }}{% endif %}" data-alt="{{ arc_variant_image.alt | default: arc_product.title | escape }}" {% if variant.id == arc_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ arc_variant_text | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — {{ 'arc.gallery.unavailable' | t }}{% endunless %}</option>
            {% endfor %}
          </select>
          <label for="ArcQuantity-{{ section.id }}">{{ 'arc.gallery.quantity' | t }}</label><input id="ArcQuantity-{{ section.id }}" type="number" name="quantity" value="{{ arc_variant.quantity_rule.min | default: 1 }}" min="{{ arc_variant.quantity_rule.min | default: 1 }}" step="{{ arc_variant.quantity_rule.increment | default: 1 }}" {% if arc_variant.quantity_rule.max != blank %}max="{{ arc_variant.quantity_rule.max }}"{% endif %} required>
          <button class="arc-liquid-add" type="submit" name="add" {% unless arc_variant.available %}disabled{% endunless %}>{% if arc_variant.available %}{{ 'arc.gallery.add' | t }}{% else %}{{ 'arc.gallery.unavailable' | t }}{% endif %}</button>
          <p class="arc-liquid-status" role="status" aria-live="polite"></p>
        {% endform %}
        <details><summary>{{ 'arc.gallery.dimensions' | t }}</summary><div>{{ section.settings.dimensions }}</div></details>
        <a href="{{ routes.cart_url }}">{{ 'arc.gallery.view_bag' | t }}</a>
      </div>
    </div>
  {% else %}<p>{{ 'arc.gallery.choose_product' | t }}</p>{% endif %}
  <span hidden data-arc-add="{{ 'arc.gallery.add' | t | escape }}" data-arc-unavailable="{{ 'arc.gallery.unavailable' | t | escape }}" data-arc-selected="{{ 'arc.gallery.selected' | t | escape }}"></span>
  <script>
    (()=>{
      const root=document.currentScript.closest('.arc-liquid');
      const select=root.querySelector('select[name="id"]');if(!select)return;
      const labels=root.querySelector('[data-arc-add]');
      function update(announce){
        const option=select.selectedOptions[0],button=root.querySelector('.arc-liquid-add'),image=root.querySelector('.arc-liquid-product-image');
        root.querySelector('.arc-liquid-price').textContent=option.dataset.money;
        button.disabled=option.dataset.available!=='true';button.textContent=button.disabled?labels.dataset.arcUnavailable:labels.dataset.arcAdd;
        if(image){image.hidden=!option.dataset.image;if(option.dataset.image){image.removeAttribute('srcset');image.src=option.dataset.image;image.alt=option.dataset.alt;}}
        const quantity=root.querySelector('input[name="quantity"]');quantity.min=option.dataset.min;quantity.step=option.dataset.step;if(option.dataset.max)quantity.max=option.dataset.max;else quantity.removeAttribute('max');if(!quantity.checkValidity())quantity.value=option.dataset.min;
        if(announce)root.querySelector('.arc-liquid-status').textContent=labels.dataset.arcSelected+' '+option.textContent;
      }
      select.addEventListener('change',()=>update(true));update(false);
    })();
  </script>
</section>
{% stylesheet %}
  .arc-liquid{color:#172329;background:#f8faf9;padding:clamp(20px,4vw,60px);font-family:inherit}.arc-liquid *{box-sizing:border-box}.arc-liquid-intro{max-width:700px;margin-bottom:30px}.arc-liquid-intro h2{font-size:clamp(36px,5vw,72px);line-height:1.05;letter-spacing:-.04em}.arc-liquid-campaign{margin:0 0 40px}.arc-liquid img{display:block;width:100%;height:auto}.arc-liquid figcaption{font-size:12px;padding:12px 0}.arc-liquid-workbench{display:grid;grid-template-columns:55% 45%;border:1px solid #68777e}.arc-liquid-media{background:#e4e9e9}.arc-liquid-product-image{aspect-ratio:1;object-fit:contain}.arc-liquid-info{padding:30px}.arc-liquid h3{font-size:42px;line-height:1.1;margin:0 0 18px}.arc-liquid-price{font-size:22px}.arc-liquid label{display:block;margin:20px 0 8px;font-size:14px}.arc-liquid select,.arc-liquid input{font:inherit;min-height:48px;border:1px solid #68777e;background:white;color:#172329;padding:10px;width:100%;border-radius:0}.arc-liquid input{max-width:110px}.arc-liquid-add{display:block;margin-top:20px;min-height:52px;background:#172329;color:white;padding:14px 20px;border:1px solid #172329;font:inherit;width:100%;cursor:pointer}.arc-liquid-add:disabled{background:#4b5960;cursor:default}.arc-liquid :focus-visible{outline:3px solid #bd3d16;outline-offset:4px}.arc-liquid details{border-top:1px solid #68777e;margin:24px 0;padding-top:16px}.arc-liquid summary{min-height:44px;cursor:pointer}.arc-liquid-status{font-size:13px}.arc-liquid a{color:#172329;text-underline-offset:4px}@media(max-width:749px){.arc-liquid-workbench{grid-template-columns:1fr}.arc-liquid-info{padding:24px}}
{% endstylesheet %}
{% schema %}
{
  "name": "ARC object gallery",
  "tag": "section",
  "class": "arc-gallery-section",
  "settings": [
    {"type":"product","id":"product","label":"Catalog product"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"ARC / Sculptural lighting"},
    {"type":"text","id":"heading","label":"Campaign heading","default":"A small architecture of light."},
    {"type":"richtext","id":"introduction","label":"Introduction","default":"<p>A single curve. A quiet presence.</p>"},
    {"type":"image_picker","id":"campaign","label":"Campaign image"},
    {"type":"text","id":"caption","label":"Campaign caption","default":"Object and space / Concept study"},
    {"type":"richtext","id":"dimensions","label":"Dimensions and disclosure","default":"<p>Illustrative concept: H 380 × W 260 × D 80 mm. Not a measured or manufactured product.</p>"}
  ],
  "blocks": [{"type":"finish","name":"Finish presentation","settings":[
    {"type":"text","id":"variant_id","label":"Exact catalog variant ID"},
    {"type":"text","id":"label","label":"Presentation label"},
    {"type":"image_picker","id":"image","label":"Finish comparison image"}
  ]}],
  "max_blocks": 12,
  "presets": [{"name":"ARC object gallery"}]
}
{% endschema %}
