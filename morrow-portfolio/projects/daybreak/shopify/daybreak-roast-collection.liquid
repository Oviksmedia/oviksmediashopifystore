{% comment %}
DAYBREAK source proposal only. Not uploaded or connected to the HTML prototype.
Native Shopify product forms; use only configured real catalog products in a draft theme.
Product variants must carry valid grind / pack combinations and actual prices.
{% endcomment %}
<section class="daybreak-liquid" aria-labelledby="daybreak-heading-{{ section.id }}">
  <header><p>DAYBREAK / THE DAILY LINEUP</p><h2 id="daybreak-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></header>
  <div class="daybreak-liquid-grid">
  {% for block in section.blocks %}
    {% assign daybreak_product = block.settings.product %}
    {% if daybreak_product != blank %}
      <article class="daybreak-liquid-card" {{ block.shopify_attributes }}>
        {% if daybreak_product.featured_image != blank %}
          {{ daybreak_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 600, 900', sizes: '(min-width: 768px) 30vw, 90vw' }}
        {% endif %}
        <h3>{{ daybreak_product.title | escape }}</h3>
        <p>{{ block.settings.roast_note | escape }}</p>
        {% capture daybreak_form_id %}daybreak-form-{{ section.id }}-{{ block.id }}{% endcapture %}
        {% form 'product', daybreak_product, id: daybreak_form_id %}
          <label for="daybreak-variant-{{ section.id }}-{{ block.id }}">Choose preparation and pack</label>
          <select name="id" id="daybreak-variant-{{ section.id }}-{{ block.id }}" required>
            <option value="" selected disabled>Choose a variant — price shown below</option>
            {% for variant in daybreak_product.variants %}
              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — Sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
          <input type="hidden" name="quantity" value="1">
          <button type="submit" {% unless daybreak_product.available %}disabled{% endunless %}>
            {% if daybreak_product.available %}Add to bag{% else %}Sold out{% endif %}
          </button>
          {{ form.errors | default_errors }}
        {% endform %}
      </article>
    {% elsif request.design_mode %}
      <p {{ block.shopify_attributes }}>Choose a coffee product for this DAYBREAK block.</p>
    {% endif %}
  {% endfor %}
  </div>
</section>
{% stylesheet %}
.daybreak-liquid{padding:48px 5%;background:#fff5db;color:#173a84}
.daybreak-liquid h2,.daybreak-liquid h3{font-family:"Daybreak Fredoka","Arial Rounded MT Bold",Arial,sans-serif;line-height:1.05;font-weight:600}
.daybreak-liquid h2{font-size:clamp(38px,5vw,64px)}.daybreak-liquid h3{font-size:30px}
.daybreak-liquid p,.daybreak-liquid label,.daybreak-liquid select,.daybreak-liquid button{font-family:"Daybreak Epilogue",Arial,sans-serif}
.daybreak-liquid-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.daybreak-liquid-card img{width:100%;height:auto;aspect-ratio:1;object-fit:cover}.daybreak-liquid-card label{display:block;margin:20px 0 8px}
.daybreak-liquid-card select{width:100%;min-height:48px;background:#fff5db;color:#173a84;border:1px solid #173a84;padding:10px;font-size:14px}
.daybreak-liquid-card button{width:100%;min-height:52px;margin-top:12px;background:#173a84;color:#fff5db;border:1px solid #173a84;border-radius:30px;padding:12px;font-size:14px}
.daybreak-liquid-card button:disabled{opacity:.6}.daybreak-liquid :focus-visible{outline:3px solid #173a84;outline-offset:4px}
@media(max-width:767px){.daybreak-liquid-grid{grid-template-columns:1fr}}
{% endstylesheet %}
{% schema %}
{
  "name":"DAYBREAK coffee lineup",
  "tag":"section",
  "class":"daybreak-section-source",
  "max_blocks":3,
  "settings":[{"type":"text","id":"heading","label":"Heading","default":"What’s your kind of coffee?"}],
  "blocks":[{"type":"coffee","name":"Coffee","settings":[{"type":"product","id":"product","label":"Coffee product"},{"type":"text","id":"roast_note","label":"Roast description","default":"Fictional concept — replace before publication"}]}],
  "presets":[{"name":"DAYBREAK coffee lineup","blocks":[{"type":"coffee"},{"type":"coffee"},{"type":"coffee"}]}]
}
{% endschema %}
