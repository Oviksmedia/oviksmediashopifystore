{{ 'morrow-premium.css' | asset_url | stylesheet_tag }}
<div class="mrw">
  <section class="mrw-hero" aria-labelledby="mrw-title-{{ section.id }}">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'mrw-campaign', widths: '750, 1200, 1800, 2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <img class="mrw-campaign" src="{{ 'morrow-campaign-v2.png' | asset_url }}" width="1536" height="1024" alt="Morrow skincare concept packaging in warm sunlight on a travertine ledge" fetchpriority="high">
    {% endif %}
    <div class="mrw-hero-copy"><p class="mrw-kicker">AN EVERYDAY KIND OF EXTRAORDINARY</p><h1 id="mrw-title-{{ section.id }}">{{ section.settings.heading | escape }}</h1><p>{{ section.settings.intro | escape }}</p><div class="mrw-hero-actions"><a class="mrw-button" href="#mrw-edit">Discover your ritual <span aria-hidden="true">↗</span></a><a class="mrw-text-link" href="{{ routes.root_url }}?view=case-study">Behind the design <span aria-hidden="true">↗</span></a></div></div>
    <div class="mrw-hero-bottom"><span>THE DAILY COLLECTION / 01</span><span>CONSIDERED CARE, BEAUTIFULLY SIMPLE.</span><a href="#mrw-edit" aria-label="Explore the daily collection">↓</a></div>
  </section>
  <section class="mrw-manifesto" aria-labelledby="mrw-manifesto-title"><p class="mrw-kicker">LESS, BUT MORE CONSIDERED.</p><h2 id="mrw-manifesto-title">Not another step.<br>A moment <em>for yourself.</em></h2><p>A cleanser. A serum. A finishing touch.<br>A small collection imagined for the way you begin<br>and end your day.</p><span class="mrw-flower" aria-hidden="true">✳</span></section>
  <section class="mrw-edit" id="mrw-edit" aria-labelledby="mrw-edit-title"><div class="mrw-heading-row"><div><p class="mrw-kicker">THE DAILY EDIT</p><h2 id="mrw-edit-title">Your shelf. <em>Simplified.</em></h2></div><a class="mrw-text-link" href="{{ routes.collections_url }}/the-daily-edit">Explore all three ↗</a></div>
    {% assign featured = section.settings.collection %}
    {% if featured != blank and featured.products.size > 0 %}
      <div class="mrw-products">{% for item in featured.products limit: 3 %}<article class="mrw-product"><a href="{{ item.url }}"><div class="mrw-product-image">{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 900 | image_tag: widths: '350, 600, 900', sizes: '(min-width: 750px) 30vw, 100vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><div class="mrw-product-line"><h3>{{ item.title | escape }}</h3><span>{{ item.price | money }}</span></div><span class="mrw-product-action">{% if item.available %}Discover the product ↗{% else %}Sold out{% endif %}</span></a></article>{% endfor %}</div>
    {% else %}
      <div class="mrw-products">{% for block in section.blocks %}<article class="mrw-product" {{ block.shopify_attributes }}><div class="mrw-product-image mrw-panel-{{ forloop.index }}" role="img" aria-label="{{ block.settings.title | escape }} concept packaging"><span class="mrw-product-tag">{{ block.settings.step | escape }}</span></div><p class="mrw-product-type">{{ block.settings.category | escape }} / {{ block.settings.size | escape }}</p><div class="mrw-product-line"><h3>{{ block.settings.title | escape }}</h3><span>CONCEPT</span></div><details class="mrw-product-detail"><summary>Discover the concept <span aria-hidden="true">+</span></summary><p>{{ block.settings.description | escape }}</p><p class="mrw-small">Fictional product. Portfolio demonstration only.</p></details></article>{% endfor %}</div>
    {% endif %}
  </section>
  <section class="mrw-ritual" id="mrw-ritual" aria-labelledby="mrw-ritual-title"><div class="mrw-ritual-image"><img src="{{ 'morrow-ritual-v2.png' | asset_url }}" alt="Morrow cream concept with linen, natural stone and a hand in warm sunlight" width="1122" height="1402" loading="lazy"><span>THE BEAUTY OF AN EVERYDAY MOMENT.</span></div><div class="mrw-ritual-copy"><p class="mrw-kicker">MAKE A LITTLE ROOM.</p><h2 id="mrw-ritual-title">A daily ritual.<br>A softer <em>rhythm.</em></h2><p>There is beauty in the things we return to. The morning light. A quiet sink. A few minutes that belong entirely to you.</p><div class="mrw-steps"><div><span>01</span><p><strong>Begin fresh.</strong><br>Start with the cleanser.</p></div><div><span>02</span><p><strong>Take a moment.</strong><br>Follow with the serum.</p></div><div><span>03</span><p><strong>Finish softly.</strong><br>Complete with the cream.</p></div></div><a class="mrw-text-link" href="#mrw-edit">Explore the daily edit <span aria-hidden="true">↗</span></a></div></section>
  <section class="mrw-philosophy" id="mrw-philosophy" aria-labelledby="mrw-philosophy-title"><p class="mrw-kicker">THE MORROW POINT OF VIEW</p><h2 id="mrw-philosophy-title">A little less noise.<br>A little more <em>intention.</em></h2><div class="mrw-values"><article><span>01 / THE COLLECTION</span><h3>Only the essentials.</h3><p>Three imagined products. Each with its own place in a beautifully simple routine.</p></article><article><span>02 / THE EXPERIENCE</span><h3>Made to feel considered.</h3><p>Quiet colors, tactile packaging, and room to pause. The details are part of the ritual.</p></article><article><span>03 / THE APPROACH</span><h3>Care without the noise.</h3><p>A calmer way to meet your everyday essentials, with space to explore each detail.</p></article></div></section>
  <section class="mrw-note" aria-labelledby="mrw-note-title"><p class="mrw-kicker">A NOTE FROM THE STUDIO</p><h2 id="mrw-note-title">“The everyday deserves<br>to feel <em>extraordinary.</em>”</h2><p>The idea behind Morrow. A self-initiated design exploration by Oviks Media.</p></section>
  <section class="mrw-faq" aria-labelledby="mrw-faq-title"><div><p class="mrw-kicker">THE DETAILS</p><h2 id="mrw-faq-title">A few things<br>to <em>know.</em></h2></div><div><details><summary>What is Morrow?<span aria-hidden="true">+</span></summary><p>A fictional skincare brand and self-initiated Shopify portfolio project by Oviks Media. The products, packaging and campaign imagery are design concepts.</p></details><details><summary>Are these products available to buy?<span aria-hidden="true">+</span></summary><p>No. This storefront demonstrates a design direction. It does not fulfill real products.</p></details><details><summary>What went into the design?<span aria-hidden="true">+</span></summary><p>Brand direction, Shopify Liquid customization, editorial layout, responsive styling, and AI-generated product campaign imagery. The catalog, product pages and demo bag use Shopify product and cart data.</p></details></div></section>
</div>
{% schema %}
{"name":"Morrow editorial homepage","settings":[{"type":"text","id":"heading","label":"Hero heading","default":"A softer start to every day."},{"type":"textarea","id":"intro","label":"Hero introduction","default":"Everyday skincare, thoughtfully imagined. A small collection. A quieter moment. A ritual that feels like you."},{"type":"image_picker","id":"hero_image","label":"Campaign image"},{"type":"collection","id":"collection","label":"Featured collection"}],"max_blocks":3,"blocks":[{"type":"concept","name":"Concept product","settings":[{"type":"text","id":"step","label":"Step label","default":"01 / CLEANSE"},{"type":"text","id":"title","label":"Product name","default":"The Daily Cleanser"},{"type":"text","id":"category","label":"Category","default":"CLEANSER"},{"type":"text","id":"size","label":"Size","default":"150 ML"},{"type":"textarea","id":"description","label":"Concept description","default":"An imagined cleanser in frosted olive glass. The first step of the Morrow routine."}]}],"presets":[{"name":"Morrow editorial homepage","blocks":[{"type":"concept"},{"type":"concept"},{"type":"concept"}]}]}
{% endschema %}
